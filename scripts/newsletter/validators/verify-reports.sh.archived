#!/usr/bin/env bash
# verify-reports.sh — Launches an isolated agent turn to Berry-verify staged reports
#
# Usage:
#   bash scripts/newsletter/validators/verify-reports.sh <run-id> <run-dir>
#
# Called by workflow.sh after compile validation passes.
# Launches an OpenClaw sub-agent for verification and writes the result.
#
# This script is the bridge between the deterministic workflow and the
# model-powered verification agent.

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
RUN_ID="${1:-}"
RUN_DIR="${2:-}"
COMPILE_OUT="${RUN_DIR}/compile-result.json"
VERIFY_OUT="${RUN_DIR}/verify-result.json"

if [ -z "$RUN_ID" ] || [ -z "$RUN_DIR" ]; then
    echo "Usage: $0 <run-id> <run-dir>" >&2
    exit 1
fi

# Read reports to verify
REPORTS_JSON="$(python3 -c "
import json
manifest = json.load(open('${COMPILE_OUT}'))
print(json.dumps(manifest.get('reports_compiled', [])))
")"
ARTIFACT_COUNT="$(python3 -c "
import json
manifest = json.load(open('${COMPILE_OUT}'))
print(manifest.get('artifact_count', 0))
")"

echo "=== Verify Reports ==="
echo "  Run: ${RUN_ID}"
echo "  Reports: ${REPORTS_JSON}"
echo "  Compile manifest: ${COMPILE_OUT}"

# For Phase 1, we write a placeholder verify result.
# Phase 2+ will integrate with an agent turn for Berry verification.
python3 -c "
import json
result = {
    'status': 'succeeded',
    'run_id': '${RUN_ID}',
    'approved': True,
    'report_results': ${REPORTS_JSON},
    'verified_artifact_count': ${ARTIFACT_COUNT},
    'blocking_issues': []
}
json.dump(result, open('${VERIFY_OUT}', 'w'), indent=2)
print(f'  Verify result written to ${VERIFY_OUT}')
print(f'  Approved: true')
print(f'  Artifacts: ${ARTIFACT_COUNT}')
"

echo "=== Verify stage complete ==="
exit 0
