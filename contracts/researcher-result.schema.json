{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poliscopic/contracts/researcher-result.schema.json",
  "title": "Task Result — Researcher Extension",
  "version": "1.0",
  "description": "Role-specific fields for Researcher returns. Used in addition to the common task-result envelope.",
  "type": "object",
  "allOf": [
    { "$ref": "task-result.schema.json" }
  ],
  "required": [
    "agent",
    "sources",
    "source_quality",
    "freshness"
  ],
  "properties": {
    "agent": {
      "const": "researcher",
      "description": "Must be 'researcher'."
    },
    "sources": {
      "type": "array",
      "description": "Every source consulted or produced.",
      "items": {
        "type": "object",
        "required": ["title", "url", "type"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "type": { "type": "string", "enum": ["primary", "secondary", "tertiary", "policy_document", "government_data", "news", "academic", "industry"] },
          "accessed_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "source_quality": {
      "type": "array",
      "description": "Quality assessment per source or overall.",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "credibility": { "type": "string", "enum": ["high", "medium", "low", "unknown"] },
          "currency": { "type": "string", "description": "How current the source is for the question." },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "freshness": {
      "type": "string",
      "description": "Assessment of how current the findings are and whether they may be stale."
    },
    "unresolved_questions": {
      "type": "array",
      "description": "Questions the research could not answer.",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
