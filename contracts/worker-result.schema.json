{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poliscopic/contracts/worker-result.schema.json",
  "title": "Task Result — Worker Extension",
  "version": "1.0",
  "description": "Role-specific fields for Worker returns. Used in addition to the common task-result envelope.",
  "type": "object",
  "allOf": [
    { "$ref": "task-result.schema.json" }
  ],
  "required": [
    "agent",
    "command",
    "working_directory",
    "pid",
    "log_path",
    "exit_status"
  ],
  "properties": {
    "agent": {
      "const": "worker",
      "description": "Must be 'worker'."
    },
    "command": {
      "type": "string",
      "description": "The exact command that was executed."
    },
    "working_directory": {
      "type": "string",
      "description": "Directory where the command was run."
    },
    "pid": {
      "type": "integer",
      "description": "Process ID of the executed command."
    },
    "log_path": {
      "type": "string",
      "description": "Path to the timestamped log file."
    },
    "exit_status": {
      "type": "integer",
      "description": "Exit code of the process. 0 = success, non-zero = failure."
    },
    "output_artifacts": {
      "type": "array",
      "description": "Files produced by the command.",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "size_bytes": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "duration_seconds": {
      "type": "number",
      "description": "Wall-clock duration of the command."
    }
  },
  "additionalProperties": false
}
