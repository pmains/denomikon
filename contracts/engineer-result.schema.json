{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poliscopic/contracts/engineer-result.schema.json",
  "title": "Task Result — Engineering Extension",
  "version": "1.0",
  "description": "Role-specific fields for Data Engineer, Software Engineer, and DevOps returns. The agent field disambiguates which engineering role performed the work.",
  "type": "object",
  "allOf": [
    { "$ref": "task-result.schema.json" }
  ],
  "required": [
    "agent",
    "changed_files"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "enum": ["data-engineer", "software-engineer", "devops-engineer"],
      "description": "Which engineering role performed the work."
    },
    "changed_files": {
      "type": "array",
      "description": "Every file created or modified.",
      "items": {
        "type": "object",
        "required": ["path", "change_type"],
        "properties": {
          "path": { "type": "string" },
          "change_type": { "type": "string", "enum": ["created", "modified", "deleted", "reviewed"] },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "array",
      "description": "Tests performed and their results.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["unit", "integration", "schema", "migration", "manual", "lint"] },
          "result": { "type": "string", "enum": ["passed", "failed", "skipped"] }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "description": "Assumptions made during this work.",
      "items": { "type": "string" }
    },
    "rollback_plan": {
      "type": "string",
      "description": "How to revert this change if needed."
    }
  },
  "additionalProperties": false
}
