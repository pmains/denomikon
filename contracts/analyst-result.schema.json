{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poliscopic/contracts/analyst-result.schema.json",
  "title": "Task Result — Analyst Extension",
  "version": "1.0",
  "description": "Role-specific fields for Analyst returns. Used in addition to the common task-result envelope.",
  "type": "object",
  "allOf": [
    { "$ref": "task-result.schema.json" }
  ],
  "required": [
    "agent",
    "methodology",
    "data_scope",
    "calculations"
  ],
  "properties": {
    "agent": {
      "const": "analyst",
      "description": "Must be 'analyst'."
    },
    "methodology": {
      "type": "array",
      "description": "Steps taken to produce the analysis.",
      "items": { "type": "string" }
    },
    "data_scope": {
      "type": "object",
      "description": "Description of the data examined.",
      "required": ["source", "temporal_range", "record_count"],
      "properties": {
        "source": { "type": "string", "description": "Database, table, query, or file path." },
        "temporal_range": { "type": "string", "description": "Date range of the data." },
        "record_count": { "type": "integer" },
        "filters_applied": {
          "type": "array",
          "description": "Any filters, exclusions, or transformations.",
          "items": { "type": "string" }
        },
        "limitations": {
          "type": "array",
          "description": "Data-quality limitations specific to the dataset.",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "calculations": {
      "type": "array",
      "description": "Key calculations, queries, or transformations used.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "method": { "type": "string" },
          "result": { "type": "string" },
          "query": { "type": "string", "description": "SQL or reference to a query file." }
        },
        "additionalProperties": false
      }
    },
    "reproducibility": {
      "type": "string",
      "description": "Instructions for reproducing this analysis."
    },
    "confidence": {
      "type": "object",
      "description": "Confidence assessment per finding.",
      "properties": {
        "overall": { "type": "string", "enum": ["high", "medium", "low"] },
        "per_finding": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding": { "type": "string" },
              "level": { "type": "string", "enum": ["high", "medium", "low"] },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
